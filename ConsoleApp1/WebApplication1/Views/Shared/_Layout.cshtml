<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid p-0 m-0">
        <div class="row g-0 vh-100 overflow-hidden flex-nowrap">

            <nav id="sidebarMenu" class="col-md-3 col-lg-2 bg-dark text-white p-3 d-flex flex-column justify-content-between h-100 flex-shrink-0">
                <div class="w-100">
                    <h4 class="text-center py-3 border-bottom border-secondary">Portfolio</h4>
                    <ul class="nav flex-column mt-3">
                        <li class="nav-item mb-2"><a href="#home" class="nav-link text-white hover-link">Home</a></li>
                        <li class="nav-item mb-2"><a href="#about" class="nav-link text-white hover-link">About Me</a></li>
                        <li class="nav-item mb-2"><a href="#skills" class="nav-link text-white hover-link">Skills</a></li>
                        <li class="nav-item mb-2"><a href="#projects" class="nav-link text-white hover-link">Projects</a></li>
                        <li class="nav-item mb-2"><a href="#contact" class="nav-link text-white hover-link">Contact</a></li>
                    </ul>
                </div>
                <div class="text-center text-muted small pt-3 w-100 border-top border-secondary">
                    &copy; 2026
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 bg-light h-100 overflow-y-auto px-md-4 py-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>