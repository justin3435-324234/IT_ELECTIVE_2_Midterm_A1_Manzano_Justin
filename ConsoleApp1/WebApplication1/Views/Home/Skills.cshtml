@{
    ViewData["Title"] = "Skills";

    var skillCategories = ViewData["SkillCategories"] as Dictionary<string, string>;
}

<section id="skills" class="py-5 my-4 border-bottom">
    <h2 class="mb-4 fw-bold">@ViewData["Title"]</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @if (skillCategories != null)
        {
            foreach (var category in skillCategories)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@category.Key</h5>
                            <p class="card-text">@category.Value</p>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>