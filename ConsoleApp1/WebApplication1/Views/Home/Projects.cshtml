@{
    ViewData["Title"] = "Projects";
    var projects = ViewData["ProjectList"] as List<Dictionary<string, object>>;
}

<section id="projects" class="py-5 my-4 border-bottom">
    <h2 class="mb-4 fw-bold">@ViewData["Title"]</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (projects != null)
        {
            foreach (var project in projects)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="~/images/briefing.png" class="flex-shrink-0 me-3 mt-3 ms-3" alt="Project Icon" style="width: 25px; height: 25px; object-fit: contain;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@project["Title"]</h5>
                            <p class="card-text flex-grow-1">@project["Description"]</p>

                            <div class="mb-3">
                                @foreach (var badge in (string[])project["Badges"])
                                {
                                    <span class="badge bg-secondary me-1">@badge</span>
                                }
                            </div>

                            <a href="@project["Link"]" target="_blank" class="btn btn-outline-primary btn-sm mt-auto">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>